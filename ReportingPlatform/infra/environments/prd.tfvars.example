# =====================================================================================
# Identity & Azure reporting platform - variable values
# Copy to prd.tfvars (or terraform.tfvars) and replace every <<FILL IN: ...>> value.
# Everything under "OPTIONAL" can be deleted to take the defaults.
# =====================================================================================

# ---------------------------------------------------------------- REQUIRED ----------

# Existing resource group to deploy into (region is taken from it).
resource_group_name = "<<FILL IN: existing resource group name>>"

# Used to build resource names, e.g. func-<prefix>-<env>-reports, st<prefix><env>rptdata.
# 2-10 lowercase letters/digits. Storage account names must be globally unique: if the
# plan fails on a name clash, change this or set names = { ... } below.
name_prefix = "<<FILL IN: e.g. idrpt>>"
environment = "prd"

# Existing virtual network and the shared subnet for the private endpoints.
virtual_network_name                = "<<FILL IN: existing VNet name>>"
virtual_network_resource_group_name = "<<FILL IN: VNet's resource group (delete this line if it's resource_group_name)>>"
private_endpoint_subnet_name        = "<<FILL IN: existing shared private endpoint subnet name>>"

# Function App outbound integration subnet. Set ONE of these two:
#   a) an existing subnet delegated to Microsoft.App/environments (/27+, no private endpoints in it)
# integration_subnet_name = "<<FILL IN: existing delegated subnet name>>"
#   b) a free address range in the VNet for Terraform to create a new delegated /27
integration_subnet_address_prefix = "<<FILL IN: e.g. 10.20.4.0/27>>"

# Client ID of the sign-in app registration
# (from setup/Set-ReportingPrerequisites.ps1 -Stage AppRegistration, run before the first apply).
easy_auth_client_id = "<<FILL IN: app registration client ID (GUID)>>"

# ---------------------------------------------------------------- PRIVATE DNS -------
# Resource IDs of your privatelink DNS zones. Delete any line (or the whole block) for zones
# whose records are created by Azure Policy / your hub team instead.
private_dns_zone_ids = {
  blob  = "/subscriptions/<<FILL IN: DNS subscription ID>>/resourceGroups/<<FILL IN: DNS resource group>>/providers/Microsoft.Network/privateDnsZones/privatelink.blob.core.windows.net"
  queue = "/subscriptions/<<FILL IN: DNS subscription ID>>/resourceGroups/<<FILL IN: DNS resource group>>/providers/Microsoft.Network/privateDnsZones/privatelink.queue.core.windows.net"
  table = "/subscriptions/<<FILL IN: DNS subscription ID>>/resourceGroups/<<FILL IN: DNS resource group>>/providers/Microsoft.Network/privateDnsZones/privatelink.table.core.windows.net"
  sites = "/subscriptions/<<FILL IN: DNS subscription ID>>/resourceGroups/<<FILL IN: DNS resource group>>/providers/Microsoft.Network/privateDnsZones/privatelink.azurewebsites.net"
}

# ---------------------------------------------------------------- OPTIONAL ----------

# tags = {
#   owner      = "identity-team"
#   costcentre = "IT-SEC"
# }

# Report schedules, UTC, NCRONTAB "{second} {minute} {hour} {day} {month} {day-of-week}".
# report_schedules = {
#   least_privilege    = "0 0 2 * * *"    # daily 02:00 (default)
#   azure_changes      = "0 30 2 * * *"   # daily 02:30 (default)
#   app_signins        = "0 0 4 * * 1"    # Mondays 04:00 (default)
#   conditional_access = "0 30 4 * * 1"   # Mondays 04:30 (default)
#   auth_methods       = "0 0 3 * * *"    # daily 03:00 (default)
# }

# Use an existing Log Analytics workspace instead of creating one.
# log_analytics_workspace_id = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<name>"

# Override generated names (e.g. to meet a naming standard or avoid a storage name clash).
# names = {
#   function_app            = "func-..."
#   service_plan            = "asp-..."
#   managed_identity        = "id-..."
#   host_storage_account    = "st..."   # 3-24 lowercase letters/digits, globally unique
#   reports_storage_account = "st..."   # 3-24 lowercase letters/digits, globally unique
#   application_insights    = "appi-..."
#   log_analytics_workspace = "log-..."
# }

# report_tenant_id         = "<tenant GUID>"   # defaults to the tenant Terraform runs in
# storage_replication_type = "ZRS"             # LRS if your region has no zones
# history_retention_days   = 400
# history_cool_after_days  = 30
# instance_memory_in_mb    = 2048
# maximum_instance_count   = 10
