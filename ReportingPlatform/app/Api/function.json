{
  "bindings": [
    {
      "name": "Request",
      "type": "httpTrigger",
      "direction": "in",
      "authLevel": "anonymous",
      "methods": [
        "get",
        "post"
      ],
      "route": "api/reports/{id?}/{action?}/{date?}"
    },
    {
      "name": "Response",
      "type": "http",
      "direction": "out"
    },
    {
      "name": "RunRequest",
      "type": "queue",
      "direction": "out",
      "queueName": "report-runs",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
